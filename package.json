{
  "name": "justinwaves-site",
  "private": true,
  "version": "2.0.0",
  "description": "Justin Waves — artist website (Next.js App Router)",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
